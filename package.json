    "watch:css": "tailwindcss -i assets/tailwind.css -o dac/static/css/dac.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "daisyui": "5.6.18",
    "tailwindcss": "4.3.2"
  }
}
